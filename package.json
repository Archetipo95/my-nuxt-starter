{
  "name": "my-nuxt-starter",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "license": "MIT",
  "engines": {
    "node": "24.12.0",
    "pnpm": "10.24.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare && simple-git-hooks",
    "postinstall": "nuxt prepare",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:unit": "vitest",
    "test:unit-coverage": "vitest --coverage",
    "test:unit-ui": "vitest --coverage --ui",
    "test:e2e": "playwright test",
    "test:e2e-ui": "playwright test --ui",
    "test:codegen": "playwright codegen http://localhost:3000/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean-project": "rm -rf node_modules .nuxt"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.79",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.2.1",
    "@nuxtjs/i18n": "^10.2.1",
    "@nuxtjs/seo": "^3.2.2",
    "@pinia/colada": "^0.18.0",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "nuxt": "^4.2.1",
    "nuxt-security": "^2.5.0",
    "vite-plugin-checker": "^0.12.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.6.1",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint": "^1.12.1",
    "@nuxt/test-utils": "^3.20.1",
    "@nuxtjs/storybook": "9.0.1",
    "@pinia/colada-nuxt": "^0.2.4",
    "@pinia/nuxt": "^0.11.3",
    "@playwright/test": "^1.57.0",
    "@storybook-vue/nuxt": "9.0.1",
    "@storybook/addon-a11y": "9.0.5",
    "@storybook/addon-docs": "9.0.5",
    "@storybook/addon-vitest": "9.0.5",
    "@storybook/vue3": "9.0.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/vue": "^8.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vueless/storybook-dark-mode": "^9.0.9",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.1.0",
    "eslint-plugin-storybook": "9.0.5",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "happy-dom": "^20.0.11",
    "lint-staged": "^16.2.7",
    "pinia": "^3.0.4",
    "playwright-core": "^1.57.0",
    "simple-git-hooks": "^2.13.1",
    "storybook": "9.0.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.8"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint --edit $1",
    "pre-commit": "pnpm lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,jsonc,md,yaml,yml}": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
